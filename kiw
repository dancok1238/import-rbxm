    status.Text = copied and "Free Key website link copied. Open your browser to continue." or ("Copy unavailable. Open: "..url)
  else
    status.Text = "Free Key website opened."
  end
end)
local busy = false
local function verifyKey()
  debugLog("Verify/execute button clicked")
  if busy then debugLog("Ignored click because loader is busy"); return end
  local key = string.gsub(input.Text or "", "^%s*(.-)%s*$", "%1")
  if key == "" then debugWarn("Verification cancelled: empty key"); status.Text = "Please enter a key first."; status.TextColor3 = Color3.fromRGB(255, 190, 70); return end
  debugLog("Sending key validation request to /execute (key value hidden)")
  busy = true; button.Text = "PLEASE WAIT"; status.Text = "Verifying key with server..."; status.TextColor3 = Color3.fromRGB(220, 230, 245)
  task.spawn(function()
    local success, result = pcall(function()
      return game:HttpGet(API .. "/execute?key=" .. HttpService:UrlEncode(key))
    end)
    if not success then
      debugWarn("API request failed: %s", tostring(result))
      status.Text = "Connection failed. Please try again."; status.TextColor3 = Color3.fromRGB(255, 85, 95)
      button.Text = "Verify Key"; busy = false; return
    end
    debugLog("API response received; length=%d", #tostring(result))
    if string.find(result, "PERMA_KEY_ERROR:", 1, true) == 1 then
      local message = string.sub(result, 17, 220)
      debugWarn("Key rejected by API: %s", tostring(message))
      local lowerMessage = string.lower(message)
      if string.find(lowerMessage, "expired", 1, true) or string.find(lowerMessage, "revoked", 1, true) then
        input.Text = ""
        savedKey = ""
        pcall(function()
          local write = (type(getgenv) == "function" and getgenv().writefile) or writefile
          if type(write) == "function" then write("PERMA_IMPORT_LAST_KEY.txt", "") end
        end)
      end
      local expired = string.find(lowerMessage, "expired", 1, true) ~= nil or string.find(lowerMessage, "kadaluarsa", 1, true) ~= nil
      if expired then
        status.Text = "Key expired. Please get a new key."
      elseif string.find(lowerMessage, "invalid", 1, true) or string.find(lowerMessage, "not found", 1, true) or string.find(lowerMessage, "revoked", 1, true) or string.find(lowerMessage, "tidak valid", 1, true) or string.find(lowerMessage, "tidak ditemukan", 1, true) then
        status.Text = "Invalid key. Please check your key and try again."
      else
        status.Text = "Verification failed: " .. message
      end
      status.TextColor3 = Color3.fromRGB(255, 80, 90)
      button.Text = "Verify Key"; busy = false; return
    end
    status.Text = "Key valid! Importer will open in 3 seconds..."; status.TextColor3 = Color3.fromRGB(70, 230, 135)
    local isPremium = string.find(key, "-PRO-", 1, true) ~= nil
    freeBadge.Text = "✓ FREE KEY"
    premiumBadge.Text = "★ PREMIUM KEY"
    freeBadge.BackgroundTransparency = isPremium and 0.55 or 0
    premiumBadge.BackgroundTransparency = isPremium and 0 or 0.55
    local authEnv = _G
    pcall(function() if type(getgenv) == "function" then authEnv = getgenv() end end)
    pcall(function() authEnv.PERMA_KEY_AUTHORIZED = true; authEnv.PERMA_KEY_TYPE = string.find(key, "-PRO-", 1, true) and "PREMIUM" or "FREE" end)
    pcall(function()
      local write = (type(getgenv)=="function" and getgenv().writefile) or writefile
      if type(write)=="function" then write("PERMA_IMPORT_LAST_KEY.txt", key) end
    end)
    debugLog("Key accepted; compiling importer source...")
    task.wait(3)
    if not gui.Parent then return end
    local compile, chunk = pcall(loadstring, result)
    if not compile or type(chunk) ~= "function" then
      debugWarn("Importer compile failed: %s", tostring(chunk))
      status.Text = "Failed to load importer. Please try again."; status.TextColor3 = Color3.fromRGB(255, 80, 90)
      button.Text = "Verify Key"; busy = false; return
    end
    fadeClose(function() gui:Destroy() end)
    task.wait(0.30)
    debugLog("Executing importer chunk...")
    local ran, failure = pcall(chunk)
    if not ran then debugWarn("Importer runtime error: %s", tostring(failure)); notify("Script mengalami error. Periksa console.")
    else debugLog("Importer chunk returned without an immediate error") end
  end)
end
button.Activated:Connect(verifyKey)
if savedKey ~= "" then
  status.Text = "Saved key found. Verifying automatically..."; status.TextColor3 = Color3.fromRGB(220, 230, 245)
  task.defer(function()
    if button and button.Parent and gui and gui.Parent then
      verifyKey()
    end
  end)
end
